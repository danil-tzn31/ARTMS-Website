{
  "name": "artms-showcase",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "media": "node scripts/process-media.mjs",
    "video": "node scripts/process-video.mjs",
    "format": "prettier --write .",
    "typecheck": "tsc -b --noEmit",
