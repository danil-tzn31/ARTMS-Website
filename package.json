    "@fontsource/space-mono": "^5.3.0",
    "@gsap/react": "^2.1.2",
    "framer-motion": "^13.1.1",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@fontsource/noto-sans-kr": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "oxlint": "^1.80.0",
    "prettier": "^3.9.6",
    "sharp": "^0.35.3",
    "subset-font": "^2.5.0",
